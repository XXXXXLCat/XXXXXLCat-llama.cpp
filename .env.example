# 可选环境变量（复制为 .env 后按需修改；不设置时使用默认值，详见 README）
#
# 开发模式：Vite dev server 将 /api 代理到该地址（默认 http://127.0.0.1:8000）
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# 生产 / 桌面构建：后端 API 基础地址（留空 = 与前端同源）
# 仅在打包时用 npm run tauri build 前设置，例如：
#   PowerShell:  $env:VITE_API_BASE="http://127.0.0.1:8000"; npm run tauri build
VITE_API_BASE=http://127.0.0.1:8000
